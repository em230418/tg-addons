<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="rental_product" inherit_id="website_sale_renting.rental_product">
        <xpath expr="//div[@id='rentingDates']" position="attributes">
            <attribute
                name="t-att-data-deny-rent-this-product"
            >deny_rent_this_product</attribute>
            <attribute
                name="t-att-data-min-start-date"
            >product._get_renting_min_start_date()</attribute>
            <attribute
                name="t-att-data-max-end-date"
            >product._get_renting_max_end_date()</attribute>
        </xpath>
        <xpath expr="//input[@name='renting_start_date']" position="attributes">
            <attribute
                name="t-att-disabled"
            >(wso.has_rented_products and wso.order_line.filtered('is_rental').product_id != product) or product._has_period_attributes()</attribute>
        </xpath>
        <xpath expr="//input[@name='renting_end_date']" position="attributes">
            <attribute
                name="t-att-disabled"
            >(wso.has_rented_products and wso.order_line.filtered('is_rental').product_id != product) or product._has_period_attributes()</attribute>
        </xpath>
    </template>

    <template id="cart" inherit_id="website_sale_renting.cart">
        <xpath expr="//div[@id='rentingDates']/../.." position="before">
            <t
                t-set="allowed_renting_periods"
                t-value="website_sale_order._get_allowed_renting_periods()"
            />
        </xpath>
        <xpath expr="//div[@id='rentingDates']/../.." position="attributes">
            <attribute
                name="t-if"
            >website_sale_order.has_rented_products and len(allowed_renting_periods) == 1 and not website_sale_order._has_products_with_period_attributes()</attribute>
        </xpath>
        <xpath expr="//div[@id='rentingDates']" position="attributes">
            <attribute
                name="t-att-data-min-start-date"
            >allowed_renting_periods[0][0]</attribute>
            <attribute
                name="t-att-data-max-end-date"
            >allowed_renting_periods[0][1]</attribute>
        </xpath>
    </template>
</odoo>
